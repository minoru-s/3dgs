+def get_robust_loss(reconstructed_image, original_image, args):
+    """Return an absolute, exposure-tolerant high-error mask.
+
+    Upstream min-max normalization always creates near-one residuals, even for
+    low-amplitude sensor noise. We estimate one global luminance affine change,
+    then combine an absolute floor, a robust MAD threshold, and a high quantile.
+    Statistics use a 4x subsample; the full-resolution mask is still returned.
+    """
+    reconstructed = reconstructed_image.detach()
+    original = original_image.detach()
+    rec_sample = reconstructed[:, ::4, ::4]
+    gt_sample = original[:, ::4, ::4]
+    rec_luma = rec_sample.mean(dim=0)
+    gt_luma = gt_sample.mean(dim=0)
+    rec_mean, gt_mean = rec_luma.mean(), gt_luma.mean()
+    rec_std = rec_luma.std().clamp_min(1e-4)
+    gt_std = gt_luma.std().clamp_min(1e-4)
+    gain = torch.clamp(gt_std / rec_std, 0.8, 1.25)
+    bias = torch.clamp(gt_mean - gain * rec_mean, -0.08, 0.08)
+    aligned = torch.clamp(gain * reconstructed + bias, 0.0, 1.0)
+    residual = torch.mean(torch.abs(aligned - original), dim=0)
+    sample = residual[::4, ::4].reshape(-1)
+    median = torch.median(sample)
+    mad = torch.median(torch.abs(sample - median)).clamp_min(1e-6)
+    robust_threshold = median + args.robust_mad_scale * 1.4826 * mad
+    quantile_threshold = torch.quantile(sample, args.robust_quantile)
+    absolute_floor = residual.new_tensor(args.robust_abs_floor)
+    threshold = torch.maximum(absolute_floor,
+                              torch.maximum(robust_threshold, quantile_threshold))
+    return residual, (residual > threshold).int()
+
